# Maintainer: Danil Zorin <45851636+Pisosenie@users.noreply.github.com>
pkgname=apolline-wall-git
_name=apolline-wall
pkgver=r0
pkgrel=1
pkgdesc='Live wallpapers for Wayland and X11: pictures, videos, shaders and Wallpaper Engine scenes, with an app to pick them'
arch=('x86_64' 'aarch64')
url='https://github.com/Pisosenie/apolline-wall'
license=('MIT OR Apache-2.0')
depends=('wayland' 'libglvnd' 'libxkbcommon' 'libgcc' 'glibc')
optdepends=(
  'mpv: video wallpapers'
  'libpulse: Wallpaper Engine scenes that move to music (parec)'
  'ffmpeg: video thumbnails in the Wallpapers app'
  'vulkan-icd-loader: faster drawing for the Wallpapers app'
  'noto-fonts-cjk: Chinese, Japanese and Korean titles in the Workshop'
  'linux-wallpaperengine-git: Wallpaper Engine scenes not drawn natively yet, and web wallpapers'
  'steamcmd: Workshop downloads without the Steam client'
  'libx11: X11 sessions, and GNOME without its extension through Xwayland'
)
makedepends=('cargo' 'git')
provides=("$_name")
conflicts=("$_name")
# ring's and QuickJS's C parts come out of gcc as LTO objects, which rust's linker (lld) can't read.
options=('!lto')
source=("$_name::git+$url.git" "apolline-scene::git+https://github.com/Pisosenie/apolline-scene.git#commit=3032e86e3a38e1096eac8e743f50d20e8b9c2214")
sha256sums=('SKIP' 'SKIP')

pkgver() {
  cd "$_name"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export RUSTFLAGS="${RUSTFLAGS-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export RUSTFLAGS="${RUSTFLAGS-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase"
  cargo test --frozen --release --workspace
}

package() {
  cd "$_name"
  install -Dm755 target/release/apolline-wall "$pkgdir/usr/bin/apolline-wall"
  install -Dm755 target/release/apolline-wallpapers "$pkgdir/usr/bin/apolline-wallpapers"
  install -Dm644 packaging/apolline-wall.service "$pkgdir/usr/lib/systemd/user/apolline-wall.service"
  install -Dm644 packaging/apolline-wallpapers.desktop "$pkgdir/usr/share/applications/apolline-wallpapers.desktop"
  install -Dm644 tests/shaders/hills.frag "$pkgdir/usr/share/apolline-wall/wallpapers/hills.frag"
  local extension=apolline-wall@pisosenie.github.io
  install -Dm644 -t "$pkgdir/usr/share/gnome-shell/extensions/$extension" gnome/$extension/{metadata.json,extension.js}
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_name/README.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 app/assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-Geist.txt"
}
